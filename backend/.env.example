# MailPilot AI backend configuration. Copy to backend/.env and fill in values.
# NEVER commit backend/.env. Secrets below are only ever read by the backend/worker.

ENVIRONMENT=development           # development | test | production
LOG_LEVEL=INFO
LOG_EMAIL_BODIES=false            # must remain false in production
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase ---------------------------------------------------------------------
# Local stack (npx supabase start) values shown; replace with your project's values.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=        # server-only; never expose to the browser
SUPABASE_JWT_SECRET=              # only for legacy HS256 projects; leave empty for JWKS (ES256)
# Direct or session-pooler connection. For the transaction pooler (port 6543) also set
# DATABASE_STATEMENT_CACHE_SIZE=0.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_STATEMENT_CACHE_SIZE=100
ATTACHMENTS_BUCKET=attachments
SIGNED_URL_TTL_SECONDS=120

# --- Token encryption -------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth / Gmail ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
SYNC_INTERVAL_MINUTES=10

# --- DGX Spark remote inference ---------------------------------------------------
# The backend only talks to DGX_LLM_API_BASE_URL. With an SSH tunnel this is a local
# forwarded port, e.g. http://127.0.0.1:18000/v1 (see docs/DGX_SPARK.md).
DGX_SSH_HOST=
DGX_SSH_USER=
DGX_SSH_PORT=22
DGX_SSH_KEY_PATH=
DGX_REMOTE_LLM_HOST=127.0.0.1
DGX_REMOTE_LLM_PORT=
DGX_LOCAL_TUNNEL_PORT=18000
DGX_LLM_API_BASE_URL=
DGX_LLM_MODEL=
DGX_LLM_API_KEY=
DGX_LLM_STRUCTURED_OUTPUT=json_schema   # json_schema | json_object | prompt
LLM_REQUEST_TIMEOUT=90
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_FALLBACK_MODE=rules                 # rules (labelled rule-based result + requeue) | queue

# --- Optional embeddings (must also run on approved infrastructure) ---------------
EMBEDDING_API_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- Attachments --------------------------------------------------------------------
ATTACHMENT_HARD_MAX_BYTES=26214400
OCR_ENABLED=false
TESSERACT_CMD=

# --- Worker ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=300
APPROVAL_TTL_HOURS=24
